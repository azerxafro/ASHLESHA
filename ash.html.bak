                    </div>

                    <!-- Digital & VLSI Card -->
                    <div class="skill-card digital glass-panel p-6 rounded-xl border border-slate-800">
                        <div class="flex items-center gap-2 text-tech-cyan font-semibold mb-3 text-sm font-mono">
                            <i data-lucide="layers" class="w-4 h-4"></i> Digital Design & VLSI
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <span class="px-2.5 py-1 bg-slate-900 text-slate-200 text-xs rounded border border-slate-800">Verilog HDL</span>
                            <span class="px-2.5 py-1 bg-slate-900 text-slate-200 text-xs rounded border border-slate-800">VHDL</span>
                            <span class="px-2.5 py-1 bg-slate-900 text-slate-200 text-xs rounded border border-slate-800">FPGA Design</span>
                            <span class="px-2.5 py-1 bg-slate-900 text-slate-200 text-xs rounded border border-slate-800">Xilinx Spartan-3E</span>
