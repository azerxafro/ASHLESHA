                        <button onclick="filterSkills('semiconductor')" class="skill-tab px-3 py-1.5 rounded-lg text-xs font-mono bg-slate-800 text-slate-300 hover:bg-slate-700">Semiconductor & VLSI</button>
                        <button onclick="filterSkills('digital')" class="skill-tab px-3 py-1.5 rounded-lg text-xs font-mono bg-slate-800 text-slate-300 hover:bg-slate-700">Digital & FPGA</button>
                        <button onclick="filterSkills('embedded')" class="skill-tab px-3 py-1.5 rounded-lg text-xs font-mono bg-slate-800 text-slate-300 hover:bg-slate-700">Embedded & Robotics</button>
                        <button onclick="filterSkills('automation')" class="skill-tab px-3 py-1.5 rounded-lg text-xs font-mono bg-slate-800 text-slate-300 hover:bg-slate-700">Automation & IIoT</button>
                        <button onclick="filterSkills('dsp')" class="skill-tab px-3 py-1.5 rounded-lg text-xs font-mono bg-slate-800 text-slate-300 hover:bg-slate-700">DSP, GIS & Software</button>
