    <!-- Site Interaction Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide) lucide.createIcons();
        });

        // Filter the skills cards by their category.
        function filterSkills(category) {
            const cards = document.querySelectorAll('#skillsGrid .skill-card');
            cards.forEach((card) => {
                card.classList.toggle('hidden', category !== 'all' && !card.classList.contains(category));
            });

            document.querySelectorAll('#skillFilterButtons .skill-tab').forEach((button) => {
                const isActive = button.getAttribute('onclick') === `filterSkills('${category}')`;
                button.classList.toggle('active', isActive);
                button.classList.toggle('bg-brand-600', isActive);
                button.classList.toggle('text-white', isActive);
                button.classList.toggle('bg-slate-800', !isActive);
                button.classList.toggle('text-slate-300', !isActive);
            });
        }

        // Prepare an email from the contact form. This uses the visitor's email app;
        // it does not send or store messages on a server.
        function handleFormSubmit(event) {
            event.preventDefault();

            const name = document.getElementById('contactName').value.trim();
            const email = document.getElementById('contactEmail').value.trim();
            const message = document.getElementById('contactMessage').value.trim();
            const subject = encodeURIComponent(`Portfolio enquiry from ${name}`);
            const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\nMessage:\n${message}`);
            const feedback = document.getElementById('formFeedback');

            if (feedback) {
                feedback.classList.remove('hidden');
                feedback.textContent = 'Opening your email application...';
            }

            window.location.href = `mailto:ashleshapokale@gmail.com?subject=${subject}&body=${body}`;
        }

        // Quick FSM Simulator for 1011
        let quickFSMState = "S0";

        function stepQuickFSM(bit) {
            let nextState = "S0";
            let output = 0;
            let message = "";

            switch (quickFSMState) {
                case "S0":
                    nextState = bit === 1 ? "S1" : "S0";
                    break;
                case "S1":
                    nextState = bit === 0 ? "S2" : "S1";
                    break;
                case "S2":
                    nextState = bit === 1 ? "S3" : "S0";
                    break;
                case "S3":
                    if (bit === 1) {
                        nextState = "S1";
                        output = 1;
                        message = "MATCH! ";
                    } else {
                        nextState = "S2";
                    }
                    break;
            }

            quickFSMState = nextState;

            document.getElementById("fsmQuickState").textContent =
                message + "State: " + quickFSMState +
                (quickFSMState === "S0" ? " (IDLE)" : "");

            const outputElement = document.getElementById("fsmQuickOut");
            outputElement.textContent = output;
            outputElement.className = output
                ? "text-emerald-400"
                : "text-rose-400";
        }


    </script>
