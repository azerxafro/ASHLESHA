<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ashlesha M. Pokale | Electronics & Semiconductor Hardware Engineer</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        },
                        tech: {
                            cyan: '#06b6d4',
                            emerald: '#10b981',
                            amber: '#f59e0b',
                            rose: '#f43f5e'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>
    <style>
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .gradient-text {
            background: linear-gradient(135deg, #818cf8 0%, #38bdf8 50%, #34d399 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .circuit-bg {
            background-image: radial-gradient(rgba(99, 102, 241, 0.15) 1px, transparent 1px);
            background-size: 24px 24px;
        }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-brand-500 selection:text-white circuit-bg min-h-screen flex flex-col">

    <!-- Navigation Header -->
    <header class="fixed top-0 left-0 right-0 z-50 glass-panel border-b border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <a href="#hero" class="flex items-center gap-2 font-bold text-lg tracking-tight">
                <span class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center text-white text-sm font-mono shadow-lg shadow-brand-500/30">AP</span>
                <span class="font-mono text-slate-200">Ashlesha's<span class="text-brand-500"> Portfolio</span></span>
            </a>

            <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
                <a href="#about" class="hover:text-brand-500 transition-colors">About</a>
                <a href="#skills" class="hover:text-brand-500 transition-colors">Skills</a>
                <a href="#projects" class="hover:text-brand-500 transition-colors">Projects</a>
                <a href="#certifications" class="hover:text-brand-500 transition-colors">Certifications</a>
                <a href="#experience" class="hover:text-brand-500 transition-colors">Experience</a>
            </nav>

            <div class="flex items-center gap-3">
                <a href="https://linkedin.com/in/ashleshampokale" target="_blank" rel="noopener noreferrer" class="p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-all" title="LinkedIn Profile">
                    <i class="fa-brands fa-linkedin-in text-xl"></i>
                </a>
                <a href="https://github.com/ashleshampokale" target="_blank" rel="noopener noreferrer" class="p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-all" title="GitHub Profile">
                    <i class="fa-brands fa-github text-xl"></i>
                </a>
                <a href="mailto:ashleshapokale@gmail.com" class="p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-all" title="Send Email">
                    <i data-lucide="mail" class="w-5 h-5"></i>
                </a>
                <a href="#contact" class="hidden sm:inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-500 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-all shadow-md shadow-brand-600/20">
                    <span>Contact</span>
                    <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Wrapper -->
    <main class="flex-grow pt-16">

        <!-- Hero Section -->
        
<!-- Hero Section -->
        <section id="hero" class="relative py-20 lg:py-28 overflow-hidden border-b border-slate-800/50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                    
                    <div class="lg:col-span-7 space-y-6">
                        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/30 text-brand-400 text-xs font-mono font-medium">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            Nagpur, Maharashtra, India • Open To Roles
                        </div>
                        
                        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
                            Ashlesha Manish Pokale
                            <span class="block text-xl sm:text-2xl lg:text-3xl font-mono text-slate-400 mt-2 font-normal">
                                <span class="gradient-text font-bold">Embedded Systems | FPGA | Semiconductor Devices | Industrial Automation | VLSI Aspirant</span>
                            </span>
                        </h1>
                        
                        <p class="text-base sm:text-lg text-slate-400 max-w-2xl leading-relaxed">
                            Electronics & Telecommunication undergraduate at SVPCET Nagpur with expertise in semiconductor device characterization, NGSpice SPICE simulation, Verilog/VHDL RTL, Xilinx FPGA synthesis, and Edge AI.
                        </p>

                        <div class="flex flex-wrap gap-4 pt-2">
                            <a href="#projects" class="bg-brand-600 hover:bg-brand-500 text-white font-semibold px-5 py-3 rounded-xl transition-all shadow-lg shadow-brand-600/25 flex items-center gap-2 text-sm">
                                <i data-lucide="cpu" class="w-4 h-4"></i>
                                View All 10 Projects
                            </a>
                            <a href="mailto:ashleshapokale@gmail.com" class="bg-slate-900 hover:bg-slate-800 text-brand-400 border border-brand-500/30 font-semibold px-5 py-3 rounded-xl transition-all flex items-center gap-2 text-sm">
                                <i data-lucide="file-text" class="w-4 h-4"></i>
                                Request Resume
                            </a>
                        </div>

                        <!-- Highlights Grid -->
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-slate-800/80">
                            <div>
                                <div class="text-xl font-bold font-mono text-white">7.70</div>
                                <div class="text-xs text-slate-400 font-medium">B.Tech CGPA (upto 6th sem)</div>
                            </div>
                            <div>
                                <div class="text-xl font-bold font-mono text-tech-cyan">IIT Bombay</div>
                                <div class="text-xs text-slate-400 font-medium">WEL Lab (NPTEL) Semiconductor Workshops</div>
                            </div>
                            <div>
                                <div class="text-xl font-bold font-mono text-emerald-400">10+</div>
                                <div class="text-xs text-slate-400 font-medium">Projects</div>
                            </div>
                            <div>
                                <div class="text-xl font-bold font-mono text-tech-amber">2nd Prize</div>
                                <div class="text-xs text-slate-400 font-medium">Best Project Award</div>
                            </div>
                        </div>
                    </div>

                    <!-- Interactive Code / FSM Preview Card -->
                    <div class="lg:col-span-5">
                        <div class="glass-panel p-6 rounded-2xl border border-slate-700/60 shadow-2xl relative">
                            <div class="flex items-center justify-between pb-4 border-b border-slate-800 font-mono text-xs text-slate-400">
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
                                    <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
                                    <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
                                    <span class="ml-2 text-slate-300">fsm_sequence_1011.vhd</span>
                                </div>
                                <span class="text-tech-cyan">Xilinx Spartan-3E</span>
                            </div>

                            <pre class="mt-4 text-xs font-mono text-slate-300 overflow-x-auto leading-relaxed space-y-1">
<span class="text-slate-500">-- VHDL Sequence Detector (1011 FSM)</span>
<span class="text-brand-400">entity</span> Sequence_Detector <span class="text-brand-400">is</span>
  <span class="text-tech-cyan">port</span>( clk, reset, din : <span class="text-tech-amber">in</span> std_logic;
        y_out : <span class="text-tech-amber">out</span> std_logic );
<span class="text-brand-400">end</span> Sequence_Detector;
<span class="text-slate-500">-- State transitions: S0 -> S1 -> S2 -> S3 -> MATCH</span>
</pre>

                            <!-- Embedded FSM State Quick Simulator -->
                            <div class="mt-6 p-4 rounded-xl bg-slate-900/90 border border-slate-800">
                                <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
                                    <span class="flex items-center gap-1.5 font-medium"><i data-lucide="cpu" class="w-3.5 h-3.5 text-tech-cyan"></i> Quick FSM State Visualizer</span>
                                    <span class="text-emerald-400 font-mono" id="fsmQuickState">State: S0 (IDLE)</span>
                                </div>
                                <div class="flex gap-2 mb-3">
                                    <button onclick="stepQuickFSM(1)" class="flex-1 py-1 px-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded text-xs font-mono text-brand-400">Clock Bit '1'</button>
                                    <button onclick="stepQuickFSM(0)" class="flex-1 py-1 px-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded text-xs font-mono text-tech-cyan">Clock Bit '0'</button>
                                </div>
                                <div class="text-[11px] text-slate-400 font-mono flex justify-between">
                                    <span>Target Sequence: <strong class="text-white">1011</strong></span>
                                    <span>Output: <strong id="fsmQuickOut" class="text-rose-400">0</strong></span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- About Section -->
        <section id="about" class="py-16 border-b border-slate-800/50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="glass-panel p-8 rounded-2xl border border-slate-800">
                    <h2 class="text-xs font-mono text-brand-400 uppercase tracking-widest mb-2">Professional Summary</h2>
                    <h3 class="text-2xl font-bold text-white mb-4">About Me</h3>
                    <p class="text-slate-300 text-sm leading-relaxed mb-6">
                        I am a final-year Electronics & Telecommunication Engineering student at St. Vincent Pallotti College of Engineering & Technology, Nagpur, with a strong passion for understanding how hardware systems are designed, optimized, and applied to solve real-world problems. My core focus spans across <strong>Embedded Systems</strong>, <strong>FPGA-based digital design</strong>, <strong>Semiconductor Devices & SPICE characterization</strong>, <strong>Industrial Automation (PLC/SCADA)</strong>, and <strong>VLSI</strong>.
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-mono">
                        <div class="p-3 bg-slate-900/80 rounded-lg border border-slate-800">
                            <span class="text-brand-400 font-bold block mb-1">Education</span>
                            <span class="text-slate-300">B.Tech ETC (2023 - 2027)</span><br>
                            <span class="text-slate-500">CGPA: 7.70/10</span>
                        </div>
                        <div class="p-3 bg-slate-900/80 rounded-lg border border-slate-800">
                            <span class="text-tech-cyan font-bold block mb-1">Top Specialization</span>
                            <span class="text-slate-300">Semiconductors & NGSpice</span><br>
                            <span class="text-slate-500">WEL, IIT Bombay (NPTEL)</span>
                        </div>
                        <div class="p-3 bg-slate-900/80 rounded-lg border border-slate-800">
                            <span class="text-emerald-400 font-bold block mb-1">Research & IIoT</span>
                            <span class="text-slate-300">MRSAC & Siemens VNIT</span><br>
                            <span class="text-slate-500">GIS, NISAR SAR & PLCs</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Final Year Major Project Spotlight Section -->
        <section id="major-project" class="py-16 border-b border-slate-800/50 bg-slate-950/80">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Section Header with Award Badge -->
                <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4 mb-8">
                    <div>
                        <div class="inline-flex items-center gap-2 text-tech-amber font-mono text-xs tracking-widest uppercase mb-2">
                            <i data-lucide="trophy" class="w-4 h-4"></i> Final Year Major Project 
                        </div>
                        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                            Indigenous Integrated Railway Track Monitoring System (ITMS)
                        </h2>
                    </div>
                    <div class="glass-panel border border-tech-amber/40 bg-tech-amber/10 px-4 py-3 rounded-xl flex items-center gap-3 shrink-0">
                        <i data-lucide="award" class="w-6 h-6 text-tech-amber"></i>
                        <div>
                            <div class="text-xs font-bold text-tech-amber">🏆 2nd Prize Winner - Core Category</div>
                            <div class="text-[11px] font-mono text-slate-300"> (₹20,000 Award)</div>
                        </div>
                    </div>
                </div>

                <!-- Main Spotlight Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    
                    <!-- Left Column: Abstract & Sensor Metrics -->
                    <div class="lg:col-span-7 space-y-6">
                        <!-- Abstract Card -->
                        <div class="glass-panel p-6 rounded-2xl border border-slate-800">
                            <div class="flex items-center gap-2 text-tech-cyan font-semibold mb-3 text-sm font-mono">
                                <i data-lucide="layers" class="w-4 h-4"></i> Project Abstract & Research Gap
                            </div>
                            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
                                Traditional railway track inspection relies on manual walking or expensive imported TRC vehicles. ITMS presents an indigenous, contactless multi-sensor edge platform built on an <strong>ARM SBC (Radxa Cubie A7A with 3-TOPS NPU)</strong> executing real-time Edge-AI defect classification alongside 6-axis IMU vibration monitoring, and GPS/LoRa geo-tagged alerting.
                            </p>

                            <!-- 3 Key Metric Cards -->
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 font-mono">
                                <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800">
                                    <span class="text-slate-400 text-[11px] block mb-1">Vision Sensor</span>
                                    <span class="text-white font-bold text-xs">Sony IMX415 4K</span>
                                    <span class="text-[10px] text-slate-500 block mt-0.5">MIPI CSI-2 Interface</span>
                                </div>
                                <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800">
                                    <span class="text-slate-400 text-[11px] block mb-1">AI Model</span>
                                    <span class="text-white font-bold text-xs">YOLOv8 Custom</span>
                                    <span class="text-[10px] text-slate-500 block mt-0.5">15 Defect Classes</span>
                                </div>
                                <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800">
                                    <span class="text-slate-400 text-[11px] block mb-1">Detection Accuracy</span>
                                    <span class="text-emerald-400 font-bold text-xs">0.867 mAP@0.5</span>
                                    <span class="text-[10px] text-slate-500 block mt-0.5">Precision 0.83 / Recall 0.85</span>
                                </div>
                            </div>
                        </div>

                        <!-- Pipeline Execution Card -->
                        <div class="glass-panel p-6 rounded-2xl border border-slate-800">
                            <div class="flex items-center gap-2 text-brand-400 font-semibold mb-3 text-sm font-mono">
                                <i data-lucide="cpu" class="w-4 h-4"></i> Sensor-to-Alert Execution Pipeline
                            </div>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 font-mono text-center text-xs">
                                <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800">
                                    <div class="text-brand-400 font-bold mb-1">1. Acquisition</div>
                                    <div class="text-[10px] text-slate-400">4K Video + IMU</div>
                                </div>
                                <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800">
                                    <div class="text-tech-cyan font-bold mb-1">2. NPU Inference</div>
                                    <div class="text-[10px] text-slate-400">Vivante 3-TOPS Engine</div>
                                </div>
                                <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800">
                                    <div class="text-emerald-400 font-bold mb-1">3. Fusion & Tag</div>
                                    <div class="text-[10px] text-slate-400">GPS</div>
                                </div>
                                <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800">
                                    <div class="text-tech-amber font-bold mb-1">4. Wireless Link</div>
                                    <div class="text-[10px] text-slate-400">LoRa Station Transceiver</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Chart & Team Info -->
                    <div class="lg:col-span-5 space-y-6">

                        <!-- Team & Supervisor Card -->
